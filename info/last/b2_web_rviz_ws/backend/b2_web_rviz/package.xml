<?xml version="1.0"?>
<package format="3">
  <name>b2_web_rviz</name>
  <version>0.2.0</version>
  <description>Web RViz gateway for ROS2/Nav2/PointCloud2/Waypoints</description>
  <maintainer email="you@example.com">B2 Developer</maintainer>
  <license>MIT</license>

  <!-- No buildtool_depend on ament_python: rosdep has no key for it on some setups,
       and colcon + sourced ROS Humble already provides the ament_python build hooks. -->

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
