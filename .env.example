# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# URL of the ROS 2 gateway running on the robot.
# nginx in the Docker container will proxy /api/* and /ws/* to this address.
GATEWAY_URL=http://192.168.123.1:8080

# Host port the frontend is accessible on (default: 3000).
FRONTEND_PORT=3000
